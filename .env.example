APP_ENV=development
APP_SECRET=change-me-in-production
DATABASE_URL=postgresql+psycopg://docmind:docmind@postgres:5432/docmind
REDIS_URL=redis://redis:6379/0
PUBLIC_API_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000

STORAGE_BACKEND=s3
STORAGE_LOCAL_DIR=/data/storage
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=docmind
S3_SECRET_KEY=docmind-dev-secret
S3_BUCKET=docmind
S3_REGION=us-east-1

AI_MODE=mock
LLM_PROVIDER=mock
LLM_MODEL=mock-grounded-v1
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=hash-384-v1
EMBEDDING_DIMENSION=384
OCR_PROVIDER=tesseract
OCR_LANGUAGES=ara+eng
RERANKER_PROVIDER=none

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

ACCESS_TOKEN_MINUTES=20
REFRESH_TOKEN_DAYS=30
MAX_UPLOAD_MB=100
DEFAULT_CHUNK_TOKENS=650
DEFAULT_CHUNK_OVERLAP=100
