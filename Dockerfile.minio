FROM alpine:3.21

ARG TARGETARCH
ARG MINIO_RELEASE=RELEASE.2025-06-13T11-33-47Z

RUN apk add --no-cache ca-certificates curl \
    && case "$TARGETARCH" in amd64|arm64) ;; *) echo "Unsupported architecture: $TARGETARCH" >&2; exit 1 ;; esac \
    && curl -fsSL "https://dl.min.io/server/minio/release/linux-${TARGETARCH}/archive/minio.${MINIO_RELEASE}" -o /usr/local/bin/minio \
    && chmod +x /usr/local/bin/minio

EXPOSE 9000 9001
VOLUME ["/data"]

ENTRYPOINT ["/usr/local/bin/minio"]
CMD ["server", "/data", "--console-address", ":9001"]
