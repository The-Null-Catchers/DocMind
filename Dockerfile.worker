FROM python:3.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-ara tesseract-ocr-eng libmagic1 && rm -rf /var/lib/apt/lists/*
COPY services/api/pyproject.toml /app/pyproject.toml
RUN pip install --no-cache-dir .
COPY services/api /app
CMD ["celery", "-A", "app.worker.celery", "worker", "--loglevel=INFO", "-Q", "document-processing,ocr,embedding,ai,exports,notifications"]
